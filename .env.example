# Copy to .env and fill in. Placeholders only — never commit real values.
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false

# Used when running the backend on the host. docker-compose overrides these for containers.
# 127.0.0.1, not localhost: on Windows "localhost" may resolve to ::1 while compose binds IPv4 only.
DATABASE_URL=postgresql+psycopg://outreach:outreach@127.0.0.1:5432/outreach
REDIS_URL=redis://127.0.0.1:6379/0
# Integration tests (separate database, created automatically by docker-compose).
TEST_DATABASE_URL=postgresql+psycopg://outreach:outreach@127.0.0.1:5432/outreach_test

# Generate with: python -m app.cli generate-encryption-key
CREDENTIAL_ENCRYPTION_KEYS=v1:REPLACE_WITH_GENERATED_KEY
CREDENTIAL_ENCRYPTION_ACTIVE_KEY=v1

# Local dev runs over http://localhost, so secure cookies must be off. MUST be true in production.
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:3000"]
SESSION_TTL_HOURS=12

# --- Research providers (see docs/provider-setup.md for how to get each key) ---
# Groq: free tier, no card. Turn on Zero Data Retention in the Groq console.
GROQ_API_KEY=
# Tavily: free plan, 1,000 credits/month, no card.
TAVILY_API_KEY=
# Brave Search API: ~$5 free credit/month, card required on file.
BRAVE_API_KEY=
SEARCH_PROVIDER_ORDER=tavily,brave
# Ordered model fallback for fact extraction. The local Ollama model is the slow, private last resort.
LLM_EXTRACTION_CHAIN=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,ollama:qwen3:4b
# Host runs use 127.0.0.1; docker-compose overrides this to host.docker.internal for the worker.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Queue research automatically for newly imported/created prospects.
RESEARCH_AUTO_START=true

# --- Added in later milestones ---
